{
  "manifest_version": 3,
  "name": "Kdovie — Ajouter un cadeau",
  "version": "0.1.0",
  "description": "Ajoutez en un clic un cadeau vu sur n'importe quel site à une de vos listes Kdovie.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter à ma liste Kdovie",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://kdovie.com/*"]
}
